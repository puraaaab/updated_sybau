# Application Environment (development | staging | production)
APP_ENV=production
VMS_SECRET_KEY=change_this_super_secret_key_in_production_32_chars

# Database Configuration
DATABASE_URL=postgresql://vms_user:vms_password@postgres:5432/vms_db
POSTGRES_USER=vms_user
POSTGRES_PASSWORD=vms_password
POSTGRES_DB=vms_db

# Qdrant Vector DB Configuration
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# Kafka Event Bus Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# MinIO Object Storage
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_password

# Frontend Configuration
VITE_DEMO_MODE=false
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173
