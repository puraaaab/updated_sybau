# Application Environment (development | staging | production)
APP_ENV=production
VMS_SECRET_KEY=change_this_to_a_secure_random_jwt_secret_key_32_chars_min!

# Database Configuration
POSTGRES_DB=vms_db
POSTGRES_USER=vms_user
POSTGRES_PASSWORD=change_this_postgres_password_in_production!
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# Qdrant Vector DB Configuration
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# Kafka Event Bus Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# MinIO Object Storage
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=vms_minio_admin
MINIO_ROOT_PASSWORD=change_this_minio_secret_password_in_production!

# Security & CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Queue Buffer Limits
QUEUE_FRAME_MAX_SIZE=100
QUEUE_INFERENCE_MAX_SIZE=50
QUEUE_RECORDING_MAX_SIZE=500
QUEUE_FORENSIC_MAX_SIZE=1000
QUEUE_NOTIFICATION_MAX_SIZE=200

# AI Model Configuration
MOONDREAM_API_KEY=
MOONDREAM_MODEL=moondream3.1-9B-A2B
