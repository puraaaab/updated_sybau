{
  "demo_mode": false,
  "yolo": {
    "model_path": "yolo26l.pt",
    "device": "cuda",
    "confidence": 0.25
  },
  "face": {
    "enabled": true,
    "detector_path": "scrfd_500m.onnx",
    "recognizer_model": "buffalo_l",
    "device": "cuda"
  },
  "vehicle": {
    "enabled": true,
    "reid_model": "market1501",
    "ocr_engine": "paddleocr",
    "device": "cuda"
  },
  "person": {
    "device": "cuda"
  },
  "florence": {
    "enabled": true,
    "model_id": "microsoft/Florence-2-base",
